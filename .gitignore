# Byte-compiled / caches / build artifacts
__pycache__/
*.pyc
.DS_Store
*.egg-info/

# Scan/experiment data and outputs -- not source code.
# The repo has ~115 .py files and tens of thousands of these; only source
# and small config/reference files should ever be tracked.
*.fits
*.npz
*.npy
*.mat
*.zip
*.mp4
*.gif
*.png
*.log

# Known large data/archive directories
/_dataarchive/
/_codearchive/
**/scanoutput/
**/scanoutputs/
**/live_outputs/
hardwarescripts/bmc/mapping_investigation/data/
hardware_control/examples/mapping_investigation/data/
hardwarescripts/command_log.txt
hardware_control/hardware_control/mountcontrol/command_log.txt
experiments/turbsim2wfe/simple-test/data/

# Dated per-run scan output dirs (e.g. tiptiltscans/2026/05-20/scan3/), which
# hold result data (json/fits/txt) rather than source, regardless of whether
# they sit under a "scanoutput(s)" folder or directly under the scan-type dir.
**/[0-9][0-9][0-9][0-9]/[0-9][0-9]-[0-9][0-9]/

# Investigation notebook with embedded image-sequence output (35MB of pixels,
# not code).
hardwarescripts/bmc/mapping_investigation/actuator_gif.ipynb
hardware_control/examples/mapping_investigation/actuator_gif.ipynb
